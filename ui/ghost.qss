/* ════════════════════════════════════════════
   DotGhostBoard — Ghost Dark Theme
   ════════════════════════════════════════════ */

/* ── Global ── */
* {
    font-family: "Inter", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 13px;
    color: #d6d9db;
    outline: none;
}

QWidget {
    background-color: #0f0f0f;
    border: none;
}

/* ── Main Window ── */
QMainWindow {
    background-color: #0f0f0f;
}

/* ── Search Bar ── */
QLineEdit {
    background-color: #1a1a1a;
    color: #d6d9db;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    padding: 6px 12px;
    selection-background-color: #22d96b33;
}
QLineEdit:focus {
    border: 1px solid #39734b;
    background-color: #111;
}
QLineEdit::placeholder {
    color: #555;
}

QLineEdit#SearchBox {
    background: #161819;
    color: #d8dcde;
    border: 1px solid #292d30;
    border-radius: 8px;
    padding: 0 14px;
    font-size: 12px;
}

QLineEdit#SearchBox:hover {
    border-color: #363b3f;
}

QLineEdit#SearchBox:focus {
    background: #181b1c;
    border: 1px solid #39734b;
}

QLineEdit#SearchBox::placeholder {
    color: #5d6468;
}

/* ── Scroll Area ── */
QScrollArea {
    background-color: #0f0f0f;
    border: none;
}
QScrollBar:vertical {
    background: #111;
    width: 6px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: #2a2a2a;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #00ff41;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0px; }

/* ── Clipboard Item Card — Polished ── */

QFrame#ItemCard {
    background-color: #151718;
    border: 1px solid #25282b;
    border-radius: 10px;
    padding: 3px;
}

QFrame#ItemCard:hover {
    background-color: #181b1d;
    border-color: #34383c;
}

/* Pinned = state indication, not giant yellow frame */
QFrame#ItemCard[pinned="true"] {
    background-color: #181811;
    border: 1px solid #34311f;
}

/* Keyboard focus */
QFrame#ItemCard[focused="true"] {
    background-color: #151b17;
    border: 1px solid #3a5943;
}

/* Selected = green edge instead of full neon box */
QFrame#ItemCard[selected="true"] {
    background-color: #121a15;
    border: 1px solid #31583c;
    border-left: 3px solid #22d96b;
}

QFrame#ItemCard[pinned="true"][selected="true"] {
    background-color: #181b14;
    border: 1px solid #4d5733;
    border-left: 3px solid #22d96b;
}

QFrame#ItemCard[selected="true"]:hover {
    background-color: #152018;
    border-color: #3e6b49;
    border-left: 3px solid #22d96b;
}

QFrame#ItemCard[selected="true"] #DragHandle {
    color: #6fd992;
}

/* ── Settings Button ── */
QPushButton#SettingsBtn {
    color: #555;
    background: transparent;
    border: none;
    font-size: 15px;
}
QPushButton#SettingsBtn:hover { color: #00ff41; }


/* ── Text inside cards ── */
QLabel#ItemText {
    font-family: "JetBrains Mono", "Fira Code", "DejaVu Sans Mono", monospace;
    color: #cdd1d3;
    font-size: 12px;
    background: transparent;
    padding: 4px 2px;
}
QLabel#ItemMeta {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    color: #646b70;
    font-size: 10px;
    background: transparent;
}
QLabel#TypeBadge {
    font-size: 10px;
    font-weight: 700;
    border-radius: 5px;
    padding: 2px 7px;
}
QLabel#TypeBadge[type="text"] {
    color: #66df8d;
    background-color: #16301e;
    border: 1px solid #244c30;
}
QLabel#TypeBadge[type="image"] {
    color: #73bff2;
    background-color: #152a38;
    border: 1px solid #23445a;
}
QLabel#TypeBadge[type="video"] {
    color: #ef8585;
    background-color: #351c1c;
    border: 1px solid #562a2a;
}

/* ── Buttons ── */
QPushButton {
    background-color: #1e1e1e;
    color: #888;
    border: 1px solid #2a2a2a;
    border-radius: 5px;
    padding: 4px 10px;
}
QPushButton:hover {
    background-color: #252525;
    color: #e0e0e0;
    border-color: #444;
}
QPushButton:pressed {
    background-color: #00ff4122;
    color: #00ff41;
    border-color: #00ff41;
}

/* Pin, Copy, Delete Buttons */
QPushButton#PinBtn,
QPushButton#CopyBtn,
QPushButton#DeleteBtn {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 0;
}

QPushButton#PinBtn[pinned="false"],
QPushButton#CopyBtn,
QPushButton#DeleteBtn {
    color: #555d62;
}

QPushButton#PinBtn[pinned="true"] {
    color: #d2ae55;
}

QPushButton#PinBtn:hover {
    color: #e0bd62;
    background: #292619;
}

QPushButton#CopyBtn:hover {
    color: #65da8b;
    background: #18251d;
}

QPushButton#DeleteBtn:hover {
    color: #e16d6d;
    background: #2a1919;
}

/* Clear History Button */
QPushButton#ClearHistoryBtn {
    background: transparent;
    color: #6b7175;
    border: 1px solid #292d30;
    border-radius: 6px;
    padding: 0 11px;
}

QPushButton#ClearHistoryBtn:hover {
    color: #e27676;
    border-color: #623737;
    background: #211616;
}

/* ── Stats Bar ── */
QLabel#StatLabel {
    color: #555;
    font-size: 11px;
    background: transparent;
}

/* ── Toolbar / Header ── */
QFrame#TopBar {
    background-color: #111;
    border-bottom: 1px solid #1e1e1e;
    padding: 4px;
}

/* ── Tabs (Settings & Dialogs) ── */
QTabWidget::pane {
    border: none;
    background: #0f0f0f;
}
QTabBar::tab {
    color: #71787c;
    background: transparent;
    border: none;
    padding: 7px 12px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
    color: #dce2de;
    border-bottom: 2px solid #36d66b;
}
QTabBar::tab:hover:!selected {
    color: #aeb6b1;
}

/* ── Tooltip ── */
QToolTip {
    background-color: #1a1a1a;
    color: #00ff41;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ── System Tray Menu ── */
QMenu {
    background-color: #161616;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #00ff4122;
    color: #00ff41;
}
QMenu::separator {
    height: 1px;
    background: #2a2a2a;
    margin: 4px 8px;
}

/* ── CheckBox (Settings) ── */
QCheckBox {
    spacing: 8px;
    color: #cccccc;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #363b3f;
    border-radius: 4px;
    background-color: #1a1a1a;
}

QCheckBox::indicator:hover {
    border: 1px solid #36d66b;
}

QCheckBox::indicator:checked {
    background-color: #2bbf5c;
    border: 1px solid #2bbf5c;
}

/* ── SpinBox (Numbers in Settings) ── */
QSpinBox {
    background-color: #181a1c;
    border: 1px solid #292d30;
    border-radius: 6px;
    padding: 4px 8px;
    color: #d8dcde;
}
QSpinBox:focus {
    border: 1px solid #3f7e52;
}
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #222;
    border-radius: 2px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #333;
}

/* ── Hint Frame (Settings Hotkey) ── */
QFrame#HintFrame {
    background-color: #111;
    border: 1px solid #222;
    border-radius: 6px;
    padding: 8px;
}

/* ════════════════════════════════════════════
   W002 — Tags
   ════════════════════════════════════════════ */

/* Tag input row container */
QWidget#TagInputRow {
    background: transparent;
}

/* Chip wrap row */
QWidget#ChipWrap {
    background: transparent;
}

/* Individual chip frame — colors are set inline per-tag in TagChip.__init__ */
QFrame#TagChip {
    border-radius: 10px;
    padding: 0 4px;
}

/* Chip label — color set inline */
QLabel#TagChipLabel {
    background: transparent;
    border: none;
    font-size: 11px;
    font-weight: 500;
}

/* Tag text input */
QLineEdit#TagInput {
    background: transparent;
    border: none;
    border-bottom: 1px solid #ffffff22;
    color: #aaa;
    font-size: 11px;
    padding: 0 2px;
    border-radius: 0;
}
QLineEdit#TagInput:focus {
    border-bottom: 1px solid #4a9eff88;
    color: #ddd;
}

/* Autocomplete dropdown */
QAbstractItemView {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    color: #ccc;
    selection-background-color: #00ff4122;
    selection-color: #00ff41;
    padding: 2px;
}

/* ════════════════════════════════════════════
   W005 — Collections Sidebar
   ════════════════════════════════════════════ */

QFrame#Sidebar {
    background-color: #0b0c0d;
    border-right: 1px solid #202326;
}

QListWidget#CollectionsList {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#CollectionsList::item {
    padding: 9px 10px;
    color: #aeb4b7;
    border-radius: 6px;
    margin-bottom: 3px;
}

QListWidget#CollectionsList::item:selected {
    background: #142019;
    color: #71dc94;
    border-left: 2px solid #36d66b;
}

QListWidget#CollectionsList::item:hover:!selected {
    background: #151718;
    color: #d3d7d9;
}

/* Add Collection button */
QPushButton#AddCollBtn {
    color: #71dc94;
    background-color: #142019;
    border: 1px solid #285437;
    border-radius: 12px; 
    font-size: 16px;
    font-weight: bold;
    padding: 0px; 
    text-align: center;
}
QPushButton#AddCollBtn:hover {
    background-color: #1c3225;
    border: 1px solid #36d66b;
    color: #ffffff;
}

/* ════════════════════════════════════════════
   Drag & Drop Visual Feedback
   ════════════════════════════════════════════ */

/* Card being hovered as a drop target */
QFrame#ItemCard[droptarget="true"] {
    border: 2px dashed #36d66b;
    background-color: #122418;
}

QFrame#ItemCard[droptarget="true"]:hover {
    border: 2px dashed #4ce281;
    background-color: #162e1f;
}

/* ════════════════════════════════════════════
   W006 — Multi-select Hint Strip
   ════════════════════════════════════════════ */

QFrame#HintStrip {
    background-color: #111513;
    border-top: none;
    border-bottom: 1px solid #202823;
}

QLabel#HintText {
    color: #737b77;
    font-size: 10px;
    background: transparent;
}

QPushButton#HintDismissBtn {
    background: transparent;
    color: #59605c;
    border: none;
    padding: 2px 7px;
}

QPushButton#HintDismissBtn:hover {
    color: #8ec99f;
}

/* ════════════════════════════════════════════
   W007 — Bulk Actions Toolbar
   ════════════════════════════════════════════ */

QFrame#BulkBar {
    background-color: #111513;
    border-top: 1px solid #233f2e;
    border-bottom: 1px solid #1c2620;
}

QLabel#BulkCountLabel {
    color: #77dd98;
    font-weight: bold;
    font-size: 12px;
    background: transparent;
}

QPushButton#BulkBtn {
    background-color: #18201a;
    color: #d2d6d8;
    border: 1px solid #29382e;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 12px;
}
QPushButton#BulkBtn:hover {
    background-color: #1f2e23;
    color: #77dd98;
    border-color: #366043;
}

QPushButton#BulkBtnDanger {
    background-color: #241919;
    color: #e27676;
    border: 1px solid #4a2828;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 12px;
}
QPushButton#BulkBtnDanger:hover {
    background-color: #2e1d1d;
    color: #ff8a8a;
    border-color: #6a3434;
}

QPushButton#BulkBtnCancel {
    background: transparent;
    color: #555;
    border: 1px solid #2a2a2a;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 12px;
}
QPushButton#BulkBtnCancel:hover {
    color: #aaa;
    border-color: #444;
}

/* ── Eclipse buttons ───────────────────────────── */
#LockBtn, #SessionLockBtn {
    background: transparent;
    color: #ff9900;
    border: 1px solid #ff9900;
    border-radius: 4px;
    font-size: 14px;
}
#LockBtn:hover, #SessionLockBtn:hover {
    background: rgba(255, 153, 0, 0.15);
}

/* ── Secret card badge ─────────────────────────── */
#SecretBadge {
    color: #ff9900;
    font-size: 11px;
    font-weight: bold;
    padding: 2px 6px;
    border: 1px solid #ff9900;
    border-radius: 10px;
    background: rgba(255, 153, 0, 0.1);
}

/* ── Reveal button on secret cards ─────────────── */
#RevealBtn {
    background: transparent;
    color: #ff9900;
    border: none;
    font-size: 11px;
    text-decoration: underline;
}
#RevealBtn:hover { color: #ffbb33; }

/* ── Settings Check Update Button ─────────────── */
QPushButton#CheckUpdateBtn {
    background: #181b1c;
    color: #9aa3a0;
    border: 1px solid #303538;
    border-radius: 5px;
    padding: 3px 9px;
    font-size: 10px;
}

QPushButton#CheckUpdateBtn:hover {
    color: #75d997;
    border-color: #3b6046;
    background: #18221b;
}

/* ── Settings Dialog Inputs ── */
QDialog#SettingsDialog QSpinBox,
QDialog#SettingsDialog QComboBox,
QDialog#SettingsDialog QLineEdit {
    background: #181a1c;
    color: #d8dcde;
    border: 1px solid #292d30;
    border-radius: 6px;
    padding: 5px 9px;
}

QDialog#SettingsDialog QSpinBox:focus,
QDialog#SettingsDialog QComboBox:focus,
QDialog#SettingsDialog QLineEdit:focus {
    border-color: #3f7e52;
}

QLabel#SettingsTitle {
    color: #e2e5e6;
    font-size: 15px;
    font-weight: 700;
}

/* ── Settings Buttons ── */
QPushButton#SettingsSaveBtn {
    background: #2bbf5c;
    color: #08100b;
    border: none;
    border-radius: 6px;
    min-height: 32px;
    font-weight: 700;
}

QPushButton#SettingsSaveBtn:hover {
    background: #35cf68;
}

QPushButton#SettingsSaveBtn:pressed {
    background: #24a94f;
}

QPushButton#SettingsCancelBtn {
    background: #1a1c1e;
    color: #8c9397;
    border: 1px solid #292d30;
    border-radius: 6px;
    min-height: 32px;
}

QPushButton#SettingsCancelBtn:hover {
    background: #202326;
    color: #d2d6d8;
}

QPushButton#ManageTagsBtn {
    background: #1a1c1e;
    color: #a0a7ab;
    border: 1px solid #292d30;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 11px;
}

QPushButton#ManageTagsBtn:hover {
    background: #222629;
    color: #e0e4e6;
    border-color: #3a4044;
}

QPushButton#EclipseBtn {
    background: #1a1c1e;
    color: #a0a7ab;
    border: 1px solid #292d30;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 12px;
}

QPushButton#EclipseBtn:hover {
    background: #222629;
    color: #e0e4e6;
    border-color: #3a4044;
}

QPushButton#EclipseBtnDanger {
    background: #241919;
    color: #e27676;
    border: 1px solid #4a2828;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 12px;
}

QPushButton#EclipseBtnDanger:hover {
    background: #2e1d1d;
    border-color: #6a3434;
    color: #ff8a8a;
}
